# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# ML weights (Ultralytics auto-downloads yolov8n.pt on first run)
*.pt

# Root-level test/temporary video files
/*.mp4
/*.avi
/*.mov

# Allow versioned demo assets
!assets/
!assets/*.mp4
!assets/*.jpg
!assets/*.png
!assets/*.md

# Generated pipeline outputs
output/
outputs/
*.log

# Uploaded test files
uploads/
backend/uploads/

# IDE files
.vscode/
.idea/
